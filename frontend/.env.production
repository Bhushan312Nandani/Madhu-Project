# In production on Vercel, proxy /api to the EC2 backend to avoid Mixed Content (HTTPS -> HTTP) blocking
REACT_APP_API_URL=/api

# Disable source maps in production for smaller bundle
GENERATE_SOURCEMAP=false

# App name for meta tags
REACT_APP_NAME=MadhuShud Oil Shop
REACT_APP_DESCRIPTION=Premium Cold-Pressed Pure Oils from Tharparkar — International Shipping Available
