# ============================================================
# MadhuShud Backend — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub!
# ============================================================

# ─── Database (PostgreSQL RDS) ────────────────────────────
DATABASE_URL="postgresql://madhuadmin:YourStrongPassword@your-rds-endpoint.rds.amazonaws.com:5432/madhuoil?sslmode=require"

# ─── MongoDB (Legacy fallback — can remove after full migration) ──
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/madhuoil

# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── JWT Secrets (use strong random strings!) ─────────────
JWT_ACCESS_SECRET=replace_with_64_char_random_string_here
JWT_REFRESH_SECRET=replace_with_another_64_char_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Admin ────────────────────────────────────────────────
ADMIN_EMAIL=admin@madhushud.com
ADMIN_PASSWORD=YourSecureAdminPassword2024!
ADMIN_JWT_SECRET=replace_with_admin_jwt_secret_here

# ─── CORS ─────────────────────────────────────────────────
# After deploying frontend, replace with your actual Vercel URL
ALLOWED_ORIGINS=http://localhost:3000,https://madhushud.vercel.app

# ─── AWS Configuration ────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=madhushud-images
CLOUDFRONT_URL=https://your-cloudfront-id.cloudfront.net

# ─── Gemini AI API ────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── WhatsApp Business API (Meta) ────────────────────────
# Get from: https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
META_APP_SECRET=8cd3cb5a14fd63ec05666049de2cc40b
META_APP_ID=1608425220922668

# ─── WhatsApp Admin Security ──────────────────────────────
# Your WhatsApp number (with country code, no +)
WHATSAPP_ADMIN_NUMBERS=923332529504
# A secret token you choose — used to verify your webhook with Meta
WHATSAPP_VERIFY_TOKEN=madhushud_webhook_secret_2024

# ─── Security ─────────────────────────────────────────────
BCRYPT_ROUNDS=12
CACHE_TTL=300
MAX_FILE_SIZE=10485760

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
